---
import '../../styles/global.css';
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Prototype</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Montserrat:wght@400;500&display=swap" rel="stylesheet">
  </head>
  <body>
    <button id="open" type="button">Open the order form</button>
    <div id="order-form-root"></div>
    <script>
      const root = document.getElementById('order-form-root')!;
      let mounted: Promise<void> | undefined;
      document.getElementById('open')!.addEventListener('click', async () => {
        mounted ??= import('@/islands/order-form/mount')
          .then((m) => m.mountOrderForm(root, 'cs'))
          .catch((error: unknown) => {
            mounted = undefined;
            throw error;
          });
        await mounted;
        const { onboardingCart } = await import('@/islands/order-form/hooks/useOnboardingCart');
        onboardingCart.openForm('header');
      });
    </script>
  </body>
</html>
