---
// Port of old:src/components/WhatsIncluded.tsx.
import { createT } from '@/i18n/t.ts';
import type { Lang } from '@/routes/types.ts';

interface Props {
  lang: Lang;
}

const t = createT(Astro.props.lang);
const items = t('whatsIncluded.items', { returnObjects: true }) as unknown as Array<{ title: string; desc: string }>;
---

<section id="whats-included" class="py-10 md:py-14" style="background-color: var(--color-bg);">
  <div class="max-w-[1400px] mx-auto px-6 md:px-12">
    <div class="rounded-lg bg-white p-6 md:p-10" style="border: 0.5px solid var(--color-line);">
      <h2 class="font-display font-bold text-2xl md:text-3xl mb-6 md:mb-8" style="color: var(--color-ink);">
        {t('whatsIncluded.title')}
      </h2>
      <ul class="grid md:grid-cols-3 gap-x-8 gap-y-6">
        {Array.isArray(items) && items.map((item) => (
          <li class="flex gap-3">
            <span
              class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full"
              style="background-color: var(--color-indigo);"
              aria-hidden="true"
            >
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
                <path d="M2.5 6.2L5 8.7L9.5 3.7" stroke="white" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <div>
              <div class="font-display font-semibold text-base" style="color: var(--color-ink);">
                {item.title}
              </div>
              <p class="mt-1 text-sm font-body" style="color: var(--color-text-secondary);">
                {item.desc}
              </p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
