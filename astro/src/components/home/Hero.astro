---
// Port of old:src/components/HeroNew.tsx and HeroStories.tsx. The stories card is static markup
// with the first slide shown; src/scripts/hero-stories.ts runs it.
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { createT } from '@/i18n/t.ts';
import type { Lang } from '@/routes/types.ts';
import { GOOGLE_RATING, PHOTO_FILTER } from './constants.ts';
// The story photos of the old site's public/, read by the build (question 106).
import heroIvBag from '../../../../public/photos/hero-iv-bag.webp';
import hotelClient from '../../../../public/photos/hotel-client.jpg';
import hotelGroup from '../../../../public/photos/hotel-group.jpg';
import nurseCloseUp from '../../../../public/photos/nurse-close-up.jpg';
import nurseHomeVisit from '../../../../public/photos/nurse-home-visit.jpg';
import nurseHotelDrip from '../../../../public/photos/nurse-hotel-drip.jpg';

interface Props {
  lang: Lang;
}

const t = createT(Astro.props.lang);

const stats = [
  { value: '3 000+', label: t('heroNew.statsVisits') },
  { value: `${GOOGLE_RATING.ratingValue}★`, label: t('heroNew.statsGoogle') },
  { value: '8:00–21:00', label: t('heroNew.statsHours') },
  { value: t('heroNew.statsSameDay'), label: t('heroNew.statsSameDayLabel') },
];

// Highlight the closing phrase of the headline when it matches (all four locales define it).
const headline = t('heroNew.headline');
const accent = t('heroNew.headlineAccent');
const hasAccent = accent && headline.endsWith(accent);
const headlineLead = hasAccent ? headline.slice(0, headline.length - accent.length) : headline;
const headlineAccent = hasAccent ? accent : '';

type CaptionKey = 'hotel' | 'home' | 'visit' | 'bring';
type Slide =
  | { type: 'image'; src: string; file: ImageMetadata; alt: string; caption: CaptionKey; position: string }
  | { type: 'video'; src: string; poster: string; alt: string; caption: CaptionKey };

// The slides of HeroStories.tsx, in its order.
const SLIDES: Slide[] = [
  { type: 'image', src: '/photos/hotel-group.jpg', file: hotelGroup, alt: 'Three guests receiving IV drips in a Prague hotel suite', caption: 'hotel', position: '50% 70%' },
  { type: 'image', src: '/photos/hero-iv-bag.webp', file: heroIvBag, alt: 'NIUS branded IV drip bag', caption: 'bring', position: 'center' },
  { type: 'video', src: '/videos/story-barter.mp4', poster: '/videos/story-barter.jpg', alt: 'A guest relaxing on the sofa during an IV drip at home', caption: 'home' },
  { type: 'image', src: '/photos/nurse-close-up.jpg', file: nurseCloseUp, alt: 'NIUS nurse setting up an IV drip at home', caption: 'home', position: '50% 40%' },
  { type: 'image', src: '/photos/nurse-hotel-drip.jpg', file: nurseHotelDrip, alt: 'NIUS nurse checking an IV drip in a hotel room', caption: 'bring', position: '50% 60%' },
  { type: 'image', src: '/photos/hotel-client.jpg', file: hotelClient, alt: 'IV drip in a Prague hotel room', caption: 'hotel', position: '50% 60%' },
  { type: 'image', src: '/photos/nurse-home-visit.jpg', file: nurseHomeVisit, alt: 'NIUS nurse during a home visit', caption: 'visit', position: '50% 55%' },
];

// Owner decision of 2026-11-16 (question 106): the browser takes a WebP of srcset, generated by the
// build with sharp, sized for the card (340-480 CSS px: 600 w covers a phone up to pixel ratio 1.75
// and a desktop at 1, the full width a pixel ratio of 2); src keeps the old file, so the content
// check compares the same images. Quality 85 keeps the card within the visual check's threshold.
const SRCSET_WIDTHS = [600];
const SIZES = '(min-width: 1024px) 480px, (min-width: 768px) 440px, 340px';
const srcsets = new Map(
  await Promise.all(
    SLIDES.flatMap((s) => (s.type === 'image' ? [s] : [])).map(async (s) => {
      const widths = [...SRCSET_WIDTHS.filter((w) => w < s.file.width), s.file.width];
      const files = await Promise.all(
        widths.map((width) => getImage({ src: s.file, width, format: 'webp', quality: 85 })),
      );
      return [s.src, files.map((f, i) => `${f.src} ${widths[i]}w`).join(', ')] as const;
    }),
  ),
);

// Every caption is in the HTML (approved difference 1); the script shows the one of the current slide.
const CAPTION_KEYS: CaptionKey[] = ['hotel', 'bring', 'home', 'visit'];
const firstCaption = SLIDES[0].caption;

const slideClass = 'absolute inset-0 h-full w-full object-cover transition-opacity duration-500';
const slideStyle = (active: boolean, position?: string) =>
  `opacity: ${active ? 1 : 0}; filter: ${PHOTO_FILTER}; transform: scale(1);${position ? ` object-position: ${position};` : ''}`;
---

<section id="home" class="relative py-10 md:py-24 lg:py-32 overflow-hidden" style="background: var(--color-bg);">
  <div class="max-w-[1400px] mx-auto px-6 md:px-12">
    <div class="grid md:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)] gap-12 items-center">
      <div class="space-y-6">
        <div class="flex items-center gap-2">
          <span class="w-2 h-2 rounded-full animate-pulse-dot" style="background-color: var(--color-blue);"></span>
          <span class="text-sm font-body font-medium" style="color: var(--color-text-secondary);">
            {t('heroNew.eyebrow')}
          </span>
        </div>

        <h1 class="font-display font-bold leading-[1.02] tracking-[-0.02em]" style="font-size: clamp(42px, 5.8vw, 84px); color: var(--color-indigo);">
          {headlineLead}{headlineAccent && (
            <span class="relative isolate inline-block whitespace-nowrap" style="color: var(--color-indigo);">
              {headlineAccent}<span
                aria-hidden="true"
                class="absolute -z-10 left-[-0.05em] right-[-0.05em] bottom-[0.04em] rounded-full"
                style="background-color: var(--color-peach); height: 0.3em;"
              ></span>
            </span>
          )}
        </h1>

        <p class="font-body text-base md:text-lg max-w-[500px]" style="color: var(--color-text-secondary);">
          {t('heroNew.subheadline')}
        </p>

        <div class="flex flex-col sm:flex-row gap-3 pt-2">
          <a
            href="#menu"
            data-cta="choose_service"
            data-analytics-source="hero"
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-full font-body font-semibold text-sm transition-opacity hover:opacity-90"
            style="background-color: var(--color-indigo); color: #ffffff;"
          >
            {t('heroNew.ctaPrimary')} ↓
          </a>
          <a
            href="https://wa.me/420773629123"
            target="_blank"
            rel="noopener noreferrer"
            data-analytics-source="hero"
            class="inline-flex items-center justify-center px-6 py-3.5 rounded-full font-body font-medium text-sm transition-colors"
            style="color: var(--color-indigo); border: 1px solid var(--color-indigo);"
          >
            {t('heroNew.ctaSecondary')} →
          </a>
        </div>
      </div>

      <div class="relative flex justify-center md:justify-end">
        <div
          aria-hidden="true"
          class="pointer-events-none absolute left-1/2 top-1/2 h-[135%] w-[135%] -translate-x-1/2 -translate-y-1/2"
          style="background: radial-gradient(closest-side, rgba(252,221,192,0.75), rgba(252,221,192,0));"
        ></div>
        <div class="relative w-full max-w-[340px] md:max-w-[440px] lg:max-w-[480px]">
          <div
            aria-hidden="true"
            class="absolute inset-0 rounded-2xl"
            style="background-color: var(--color-peach); transform: rotate(5deg) translate(10px, 4px);"
          ></div>
          <div
            aria-hidden="true"
            class="absolute inset-0 rounded-2xl"
            style="background-color: var(--color-blue); opacity: 0.4; transform: rotate(-4deg) translate(-8px, 6px);"
          ></div>

          <div
            data-stories
            role="group"
            aria-roledescription="carousel"
            aria-label="NIUS"
            tabindex="0"
            class="relative w-full overflow-hidden rounded-2xl select-none touch-pan-y"
            style="aspect-ratio: 3 / 4; background-color: var(--color-indigo); box-shadow: 0 24px 60px rgba(21,63,77,0.22);"
          >
            {/* The slides after the first are not displayed and not fetched until the page has
                loaded (hero-stories.ts): they are transparent anyway, and fetched at once they
                delayed the first photo (Largest Contentful Paint). */}
            {SLIDES.map((s, i) =>
              s.type === 'image' ? (
                <img
                  data-story
                  hidden={i !== 0}
                  data-caption={s.caption}
                  data-alt={s.alt}
                  src={s.src}
                  srcset={srcsets.get(s.src)}
                  sizes={SIZES}
                  alt={i === 0 ? s.alt : ''}
                  aria-hidden={i === 0 ? 'false' : 'true'}
                  width="1086"
                  height="1448"
                  loading={i === 0 ? 'eager' : 'lazy'}
                  fetchpriority={i === 0 ? 'high' : 'auto'}
                  draggable="false"
                  class={slideClass}
                  style={slideStyle(i === 0, s.position)}
                />
              ) : (
                <video
                  data-story
                  hidden={i !== 0}
                  data-caption={s.caption}
                  data-poster={s.poster}
                  src={s.src}
                  aria-label={s.alt}
                  muted
                  playsinline
                  preload="none"
                  class={slideClass}
                  style={slideStyle(i === 0)}
                ></video>
              ),
            )}

            <div
              class="pointer-events-none absolute inset-x-0 top-0 h-32"
              style="background: linear-gradient(to bottom, rgba(13,42,53,0.6), rgba(13,42,53,0));"
            ></div>
            <div
              class="pointer-events-none absolute inset-x-0 bottom-0 h-32"
              style="background: linear-gradient(to top, rgba(13,42,53,0.55), rgba(13,42,53,0));"
            ></div>

            <div class="pointer-events-none absolute inset-x-3 top-3 flex gap-1" aria-hidden="true">
              {SLIDES.map(() => (
                <span class="h-[3px] flex-1 overflow-hidden rounded-full bg-white/35">
                  <span data-story-progress class="block h-full rounded-full bg-white" style="width: 0%;"></span>
                </span>
              ))}
            </div>

            <div class="pointer-events-none absolute left-3 top-7 flex items-center gap-2.5">
              <span class="grid h-9 w-9 place-items-center rounded-full ring-2 ring-white" style="background-color: var(--color-indigo);">
                <img src="/brand/logo-mark-light.svg" alt="" width="20" height="20" class="h-5 w-5" />
              </span>
              <span class="leading-tight text-white [filter:drop-shadow(0_1px_2px_rgb(0_0_0/0.1))_drop-shadow(0_1px_1px_rgb(0_0_0/0.06))]">
                <span class="block font-display text-sm font-bold">NIUS</span>
                <span class="block font-body text-[11px] opacity-85">Praha · 8:00–21:00</span>
              </span>
            </div>

            {CAPTION_KEYS.map((key) => (
              <div data-story-caption={key} hidden={key !== firstCaption} class="pointer-events-none absolute inset-x-4 bottom-4">
                <span
                  class="inline-block animate-in fade-in slide-in-from-bottom-2 duration-500 rounded-full bg-white px-4 py-2 font-body text-sm font-medium"
                  style="color: var(--color-indigo);"
                >
                  {t(`heroNew.captions.${key}`)}
                </span>
              </div>
            ))}

            <button type="button" class="sr-only" data-story-prev>Previous</button>
            <button type="button" class="sr-only" data-story-next>Next</button>

            <div data-story-gestures class="absolute inset-0 cursor-pointer"></div>
          </div>

          <div
            class="absolute -bottom-3 -right-2 md:-right-5 flex items-center gap-2 rounded-full bg-white px-4 py-2 font-body"
            style="box-shadow: 0 8px 24px rgba(21,63,77,0.18);"
          >
            <span class="font-display text-sm font-bold" style="color: var(--color-ink);">
              {GOOGLE_RATING.ratingValue}★
            </span>
            <span class="text-xs" style="color: var(--color-text-muted);">{t('heroNew.statsGoogle')}</span>
          </div>
        </div>
      </div>
    </div>

    <ul
      class="flex flex-wrap items-start justify-center gap-y-6 mt-10 md:mt-14 pt-8"
      style="border-top: 0.5px solid var(--color-line);"
    >
      {stats.map((stat) => (
        <li
          class="w-1/2 md:w-auto md:px-12 text-center md:border-l first:md:border-l-0"
          style="border-color: var(--color-line);"
        >
          <span class="font-display font-bold text-xl" style="color: var(--color-ink);">{stat.value}</span>
          <span class="block text-xs font-body" style="color: var(--color-text-muted);">{stat.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>
