---
import { serializeJsonLd } from '@/seo/head.ts';

interface Props {
  target: string;
}

const { target } = Astro.props;
// A JSON string is a JavaScript string literal; serializeJsonLd also escapes "<", so that no
// target can close the script element.
const redirectScriptTarget = serializeJsonLd(target);
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta http-equiv="refresh" content={`0;url=${target}`}>
  <link rel="canonical" href={target}>
  <meta name="robots" content="noindex">
  <title>Redirecting...</title>
  <script is:inline set:html={`window.location.replace(${redirectScriptTarget});`}></script>
</head>
<body>
  <p>This page has moved. <a href={target}>Click here</a> if you are not redirected.</p>
</body>
</html>
