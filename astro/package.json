{
  "name": "nius-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "predev": "node scripts/sync-public.mjs",
    "dev": "astro dev",
    "prebuild": "node scripts/sync-public.mjs",
    "build": "astro build && node scripts/finalize-dist.mjs",
    "preview": "astro preview",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "i18n:check": "npm --prefix .. run i18n:check",
    "check:env": "node scripts/check-env.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "7.1.3",
    "@lucide/astro": "^1.71.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.9",
    "i18next": "^27.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
