---
import { ArrowRight, Calendar, Clock } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import BookingLink from '@/components/BookingLink.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import { blogPosts } from '@/data/blogPosts.ts';
import { blogImageUrl, formatPostDate } from '@/components/blog/posts.ts';
import { pageUrl } from '@/routes/urls.ts';
import type { Lang, PageRoute } from '@/routes/types.ts';
import type { PageMeta } from '@/seo/head.ts';

interface Props {
  route: PageRoute;
  lang: Lang;
}

const { route, lang } = Astro.props;

const meta: PageMeta = {
  title: "Nurse in Prague Blog | Home Nursing Guides",
  description: "Practical guides from registered nurses in Prague on home nursing, IV drips, wound care and elderly care, explained in plain, friendly language, with no jargon.",
  ogImage: "https://www.nius.cz/og-blog.jpg",
};
---

<BaseLayout route={route} lang={lang} meta={meta}>
  <div class="flex min-h-screen flex-col bg-background">
    <Header route={route} lang={lang} />
    <Breadcrumbs lang={lang} items={[{ label: "Blog" }]} />
    <main class="flex-1" role="main">
      {/* Hero Section */}
      <section class="py-20 bg-bone">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mx-auto text-center animate-fade-in">
            <h1 class="text-4xl md:text-5xl font-bold text-secondary mb-4">
              Healthcare Blog
            </h1>
            <p class="text-lg text-muted-foreground">
              Expert insights on home healthcare, nursing services, and medical care in Prague
            </p>
          </div>
        </div>
      </section>

      {/* Blog Posts Grid */}
      <section class="py-16">
        <div class="container mx-auto px-4">
          <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
            {blogPosts.map((post, index) => (
              <div
                class="rounded-lg border bg-card text-card-foreground shadow-xs overflow-hidden hover:shadow-card transition-all duration-300 hover:-translate-y-1 animate-slide-up"
                style={`animation-delay: ${index * 100}ms;`}
              >
                <a href={pageUrl(`blog:${post.slug}`, lang)}>
                  <div class="aspect-video bg-muted overflow-hidden">
                    <img
                      src={blogImageUrl(post)}
                      alt={post.title}
                      class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                      loading="lazy"
                    />
                  </div>
                  <div class="p-6">
                    <div class="flex items-center gap-4 text-sm text-muted-foreground mb-3">
                      <span class="px-3 py-1 bg-primary/10 text-primary rounded-full text-xs font-medium">
                        {post.category}
                      </span>
                      <div class="flex items-center gap-1">
                        <Calendar class="h-4 w-4" />
                        {formatPostDate(post.date, 'short')}
                      </div>
                    </div>
                    <h3 class="text-xl font-semibold text-secondary mb-3 line-clamp-2 hover:text-primary transition-colors">
                      {post.title}
                    </h3>
                    <p class="text-muted-foreground mb-4 line-clamp-3">
                      {post.excerpt}
                    </p>
                    <div class="flex items-center justify-between">
                      <div class="flex items-center gap-1 text-sm text-muted-foreground">
                        <Clock class="h-4 w-4" />
                        {post.readTime}
                      </div>
                      <div class="flex items-center gap-1 text-primary font-medium group-hover:gap-2 transition-all">
                        Read more
                        <ArrowRight class="h-4 w-4" />
                      </div>
                    </div>
                  </div>
                </a>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* CTA Section */}
      <section class="py-16 bg-muted/30">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mx-auto text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4">
              Need Professional Home Nursing Care?
            </h2>
            <p class="text-lg text-muted-foreground mb-8">
              Book a qualified nurse to visit your home in Prague. Same-day appointments available.
            </p>
            <BookingLink>
              <Button size="lg" class="group">
                Book a Nurse Now
                <ArrowRight class="ml-2 h-5 w-5 transition-transform group-hover:translate-x-1" />
              </Button>
            </BookingLink>
          </div>
        </div>
      </section>
    </main>
    <Footer route={route} lang={lang} />
  </div>
</BaseLayout>
