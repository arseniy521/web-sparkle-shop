---
// Port of old:src/pages/IVDripHotelPrague.tsx (route id `iv-drip-hotel`, English only; the texts
// are written in the old component, not in the locale files).
import { CircleCheck, Clock, Hotel, MessageCircle, Phone, Shield, Star } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import MenuSection from '@/components/home/MenuSection.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import BookingLink from '@/components/BookingLink.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import RelatedServices from '@/components/RelatedServices.astro';
import FloatingWhatsApp from '@/components/FloatingWhatsApp.astro';
import FaqAccordion from '@/components/drip-landing/FaqAccordion.astro';
import { GOOGLE_RATING } from '@/components/home/constants.ts';
import { absoluteUrl, pageUrl } from '@/routes/urls.ts';
import type { Lang, PageRoute } from '@/routes/types.ts';
import type { PageMeta } from '@/seo/head.ts';

interface Props {
  route: PageRoute;
  lang: Lang;
}

const { route, lang } = Astro.props;

const phone = '+420773629123';
const whatsappNumber = '420773629123';

const whatsappMessage = "Hi, I'd like to book an IV drip at my hotel in Prague.";
const whatsappLink = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;

// The old constant: old:src/constants/reviews.ts.
const BEST_RATING = '5';

const trustBadges = [
  { label: 'Registered Nurses', Icon: Shield },
  { label: `${GOOGLE_RATING.ratingValue}/${BEST_RATING} on Google`, Icon: Star },
  { label: 'Any Hotel in Prague', Icon: Hotel },
  { label: 'Same-Day Visits 8:00–21:00', Icon: Clock },
];

const steps = [
  { title: 'Book Online or Call', description: 'WhatsApp, phone, or online form. Tell us your hotel and preferred time.' },
  { title: 'Nurse Visits Your Hotel', description: 'Same-day visits, daily 8:00–21:00. We confirm the arrival time after you book.' },
  { title: 'IV Session (30-60 min)', description: 'Relax in your room while the drip runs, with the nurse by your side.' },
  { title: 'Wrap-Up', description: 'The nurse removes the line and answers your questions. No clinic visit needed.' },
];

const drips = [
  {
    name: 'Pure Hydrate',
    price: 'from 2,550 CZK',
    tag: 'After Travel',
    description: 'Fluids and electrolytes for rehydration after a long flight or a busy day.',
    includes: ['Saline fluids', 'Electrolytes', 'Vitamins'],
  },
  {
    name: 'Immunity Power',
    price: 'from 3,250 CZK',
    tag: 'Vitamin C',
    description: 'Vitamin C and fluids, a classic choice for travellers.',
    includes: ['Vitamin C', 'Saline hydration', 'B-vitamins'],
  },
  {
    name: 'CEO Recharge',
    price: 'from 4,550 CZK',
    tag: 'Business Trips',
    description: 'Vitamins, minerals and fluids for a packed conference or business-trip schedule.',
    includes: ['Magnesium', 'B-complex', 'Saline base'],
  },
  {
    name: 'Jet Lag Recovery',
    price: 'from 3,250 CZK',
    tag: 'Long-Haul Flights',
    description: 'Rehydration with vitamins and electrolytes after a long-haul flight.',
    includes: ['Saline fluids', 'Electrolytes', 'B-vitamins'],
  },
];

const faqItems = [
  {
    question: 'Do you come to any hotel in Prague?',
    answer: 'Yes. We visit any hotel, hostel, Airbnb or private apartment across Prague.',
  },
  {
    question: 'When can a nurse visit?',
    answer: 'Same-day visits, daily 8:00–21:00. We confirm the arrival time after you book.',
  },
  {
    question: 'What about hotel reception / security?',
    answer: 'Our nurses carry professional ID and equipment in discreet bags. If your hotel requires advance notice, we can call ahead on your behalf.',
  },
  {
    question: 'Do I need a prescription?',
    answer: 'Every infusion is prescribed by a doctor after a short health assessment, and the consultation is included in the price.',
  },
];

// The answers are plain text: escaped for set:html in the shared accordion.
const escapeHtml = (value: string) => value.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
const faqAccordionItems = faqItems.map((item) => ({ question: item.question, answerHtml: escapeHtml(item.answer) }));

const seoDescription =
  'IV drip visits to your Prague hotel room: vitamins and hydration from 1,650 CZK, given by registered nurses. Same-day visits, daily 8:00–21:00.';

const ivDripsUrl = pageUrl('iv-drips', lang);

const meta: PageMeta = {
  title: 'IV Drip at Your Hotel in Prague | NIUS',
  description: seoDescription,
  keywords: 'iv drip hotel prague, iv therapy hotel prague, mobile iv drip prague hotel, nurse to hotel prague, vitamin drip hotel prague',
  ogImage: 'https://www.nius.cz/og-image.jpg',
  ogType: 'website',
  schema: {
    '@context': 'https://schema.org',
    '@graph': [
      {
        '@type': 'MedicalBusiness',
        name: 'NIUS - IV Drip Hotel Service Prague',
        description: seoDescription,
        url: absoluteUrl(pageUrl('iv-drip-hotel', 'en')),
        image: 'https://www.nius.cz/og-image.jpg',
        telephone: phone,
        priceRange: '1650-4550 CZK',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Praha',
          addressCountry: 'CZ',
        },
        areaServed: { '@type': 'City', name: 'Prague' },
        openingHours: 'Mo-Su 08:00-21:00',
        medicalSpecialty: ['IV Therapy', 'Mobile Nursing', 'Hotel Medical Services'],
      },
      {
        '@type': 'FAQPage',
        mainEntity: faqItems.map((item) => ({
          '@type': 'Question',
          name: item.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: item.answer,
          },
        })),
      },
    ],
  },
};
---

<BaseLayout route={route} lang={lang} meta={meta}>
  <script is:inline slot="head" src="/js/nius-menu.js" defer></script>
  <div class="min-h-screen flex flex-col">
    <Header route={route} lang={lang} />

    <main class="flex-1">
      <Breadcrumbs lang={lang} items={[
        { label: 'Services', href: pageUrl('home', lang) + '#services' },
        { label: 'IV Drips Prague', href: ivDripsUrl },
        { label: 'Hotel IV Drip' },
      ]} />

      {/* Hero */}
      <section class="py-16 md:py-20 px-4 bg-bone">
        <div class="container mx-auto max-w-6xl">
          <div class="flex flex-wrap items-center justify-center gap-4 md:gap-8 mb-8 text-sm">
            {trustBadges.map(({ label, Icon }) => (
              <div class="flex items-center gap-2">
                <Icon class="w-5 h-5 text-primary" />
                <span class="font-medium">{label}</span>
              </div>
            ))}
          </div>

          <div class="text-center space-y-6">
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold leading-tight md:leading-none lg:leading-none">
              IV Drip Delivered to Your Hotel Room in Prague
            </h1>
            <p class="text-lg md:text-xl text-muted-foreground max-w-3xl mx-auto">
              Registered nurse at your hotel. Same-day visits, daily 8:00–21:00. We confirm the arrival time after you book.
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center pt-4">
              <a href={`tel:${phone}`}>
                <Button size="lg" class="w-full sm:w-auto">
                  <Phone class="mr-2 h-5 w-5" />
                  Call {phone}
                </Button>
              </a>
              <a href={whatsappLink} target="_blank" rel="noopener noreferrer">
                <Button size="lg" variant="outline" class="w-full sm:w-auto">
                  <MessageCircle class="mr-2 h-5 w-5" />
                  WhatsApp Booking
                </Button>
              </a>
              <BookingLink>
                <Button size="lg" variant="secondary" class="w-full sm:w-auto">
                  Book Online
                </Button>
              </BookingLink>
            </div>
          </div>
        </div>
      </section>

      {/* How It Works */}
      <section class="py-16 md:py-20 px-4 bg-muted/30">
        <div class="container mx-auto max-w-5xl">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">How It Works</h2>
            <p class="text-lg text-muted-foreground">From booking to wrap-up in 4 simple steps</p>
          </div>
          <div class="grid md:grid-cols-4 gap-6">
            {steps.map((step, index) => (
              <Card class="p-6">
                <div class="h-10 w-10 rounded-full bg-primary/10 text-primary flex items-center justify-center font-bold mb-4">
                  {index + 1}
                </div>
                <h3 class="font-semibold mb-2">{step.title}</h3>
                <p class="text-sm text-muted-foreground">{step.description}</p>
              </Card>
            ))}
          </div>
        </div>
      </section>

      {/* Popular Hotel IV Drips */}
      <section class="py-16 md:py-20 px-4">
        <div class="container mx-auto max-w-6xl">
          <div class="text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Popular Hotel IV Drips</h2>
            <p class="text-lg text-muted-foreground max-w-3xl mx-auto">
              Popular with tourists and business travellers staying in Prague
            </p>
          </div>
          <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-6">
            {drips.map((drip) => (
              <Card class="p-6 flex flex-col">
                <div class="text-xs font-semibold text-primary mb-3">{drip.tag}</div>
                <h3 class="text-2xl font-semibold mb-2">{drip.name}</h3>
                <div class="text-3xl font-bold mb-2">{drip.price}</div>
                <p class="text-sm text-muted-foreground mb-4">{drip.description}</p>
                <div class="space-y-2 mb-6 flex-1">
                  {drip.includes.map((item) => (
                    <div class="flex gap-2 text-sm">
                      <CircleCheck class="h-4 w-4 text-primary shrink-0 mt-0.5" />
                      <span>{item}</span>
                    </div>
                  ))}
                </div>
                <a
                  href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Hi, I'd like to book the ${drip.name} IV drip at my hotel in Prague.`)}`}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Button variant="outline" class="w-full">Book via WhatsApp</Button>
                </a>
              </Card>
            ))}
          </div>
          <p class="text-sm text-muted-foreground text-center mt-6">
            <a href={ivDripsUrl} class="underline hover:text-primary">View full IV drip menu</a> with current prices.
          </p>
        </div>
      </section>

      {/* Any hotel */}
      <section class="py-16 md:py-20 px-4 bg-muted/30">
        <div class="container mx-auto max-w-5xl">
          <Card class="p-6 md:p-8 bg-primary/5 border-primary/20">
            <h2 class="text-2xl md:text-3xl font-bold mb-4">Any Hotel in Prague</h2>
            <p class="text-muted-foreground mb-4">
              We visit guests at any hotel in Prague, as well as <strong>Airbnbs, hostels and private apartments</strong>. If you have an address, we'll come to you.
            </p>
            <p class="text-sm text-muted-foreground">
              Same-day visits, daily 8:00–21:00. We confirm the arrival time after you book.
            </p>
          </Card>
        </div>
      </section>

      {/* FAQ */}
      <section class="py-16 md:py-20 px-4">
        <div class="container mx-auto max-w-3xl">
          <div class="text-center mb-10">
            <h2 class="text-3xl md:text-4xl font-bold mb-4">Frequently Asked Questions</h2>
            <p class="text-lg text-muted-foreground">Answers about hotel IV drip visits in Prague</p>
          </div>
          <FaqAccordion items={faqAccordionItems} />
        </div>
      </section>

      <MenuSection lang={lang} />

      {/* Bottom CTA */}
      <section class="py-16 md:py-20 px-4 bg-primary text-primary-foreground">
        <div class="container mx-auto max-w-4xl text-center">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Stay in Your Hotel Room. We Come to You.
          </h2>
          <p class="text-lg opacity-90 mb-8">
            Same-day visits, daily 8:00–21:00. We confirm the arrival time after you book.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href={`tel:${phone}`}>
              <Button size="lg" variant="secondary" class="w-full sm:w-auto">
                <Phone class="mr-2 h-5 w-5" />
                Call {phone}
              </Button>
            </a>
            <a href={whatsappLink} target="_blank" rel="noopener noreferrer">
              <Button size="lg" variant="outline" class="w-full sm:w-auto bg-transparent border-primary-foreground text-primary-foreground hover:bg-primary-foreground hover:text-primary">
                <MessageCircle class="mr-2 h-5 w-5" />
                WhatsApp Booking
              </Button>
            </a>
            <BookingLink>
              <Button size="lg" variant="secondary" class="w-full sm:w-auto">
                Book Online
              </Button>
            </BookingLink>
          </div>
          <p class="text-sm opacity-80 mt-6">
            Registered nurses. Discreet service. NIUS is not an emergency service: call 155/112.
          </p>
        </div>
      </section>

      {/* Internal Links */}
      <section class="py-10 px-4">
        <div class="container mx-auto max-w-5xl">
          <Card class="p-6">
            <h2 class="text-xl font-semibold mb-3">Explore More IV Drip Services</h2>
            <p class="text-sm text-muted-foreground leading-relaxed mb-4">
              Looking for something specific? Check out our full range of IV therapy services in Prague.
            </p>
            <div class="flex flex-wrap gap-3">
              <a href={ivDripsUrl}>
                <Button variant="outline" size="sm">All IV Drips in Prague</Button>
              </a>
              <a href={pageUrl('rehydration-drip', lang)}>
                <Button variant="outline" size="sm">Rehydration IV Drip</Button>
              </a>
            </div>
          </Card>
        </div>
      </section>

      <RelatedServices lang={lang} currentId={route.id} />
    </main>

    <Footer route={route} lang={lang} />
    <FloatingWhatsApp />
  </div>
</BaseLayout>
