---
import { serializeJsonLd } from '@/seo/head.ts';

interface Props {
  target: string;
}

const { target } = Astro.props;
// As old:scripts/redirects.mjs buildRedirectStub: the script runs first and keeps the query string
// and the hash (?ref=, gclid, utm_*) of the incoming address; the meta refresh is the fallback
// without JavaScript and the redirect signal for crawlers. No robots tag: "noindex" would
// contradict "this page has moved". A JSON string is a JavaScript string literal; serializeJsonLd
// also escapes "<", so that no target can close the script element.
const redirectScript = `window.location.replace(${serializeJsonLd(target)} + window.location.search + window.location.hash);`;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <script is:inline set:html={redirectScript}></script>
  <meta http-equiv="refresh" content={`0;url=${target}`}>
  <link rel="canonical" href={target}>
  <title>Redirecting...</title>
</head>
<body>
  <p>This page has moved. <a href={target}>Click here</a> if you are not redirected.</p>
</body>
</html>
