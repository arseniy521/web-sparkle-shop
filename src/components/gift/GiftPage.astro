---
/**
 * The gift voucher landing pages: port of old:src/pages/WomensDayGift.tsx and
 * old:src/pages/BirthdayGift.tsx. The two old components are the same page with different texts
 * and three differences: the Women's Day countdown, the birthday cake badge and corporate block,
 * and the section backgrounds of "How to order" and the FAQ.
 */
import {
  ArrowRight,
  Building2,
  Cake,
  ChevronDown,
  CircleCheck,
  Clock,
  Droplets,
  Gift,
  Heart,
  Mail,
  MapPin,
  MessageCircle,
  Phone,
  Shield,
  Sparkles,
  Star,
} from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/ui/Button.astro';
import Card from '@/components/ui/Card.astro';
import GiftFaq from '@/components/gift/GiftFaq.astro';
import { createT } from '@/i18n/t.ts';
import { absoluteUrl, pageUrl } from '@/routes/urls.ts';
import { faqPageSchema } from '@/seo/schema.ts';
import type { Lang, PageRoute } from '@/routes/types.ts';
import type { PageMeta } from '@/seo/head.ts';

type Kind = 'womensDay' | 'birthday';

interface Props {
  route: PageRoute;
  lang: Lang;
  kind: Kind;
}

const { route, lang, kind } = Astro.props;
const t = createT(lang);
const k = kind === 'womensDay' ? 'womensDayGift' : 'birthdayGift';

const VARIANTS = {
  womensDay: {
    whatsappMessage: {
      ru: 'Здравствуйте! Хочу заказать подарочный сертификат на 8 марта, капельницу «Витамины и минералы Классик».',
      cs: 'Dobrý den! Chci objednat dárkový voucher na 8. března: infuzi „Vitamíny a minerály Classic“.',
      en: "Hi! I'd like to order a Women's Day gift voucher: Vitamin & Mineral Classic IV Drip.",
    },
    productName: "Vitamin & Mineral Classic IV Drip Gift Voucher, Women's Day Prague",
    validFrom: '2026-02-01',
    priceValidUntil: '2026-05-31',
  },
  birthday: {
    whatsappMessage: {
      ru: 'Здравствуйте! Хочу заказать подарочный сертификат на день рождения, капельницу «Витамины и минералы Классик».',
      cs: 'Dobrý den! Chci objednat dárkový voucher k narozeninám, infuzi „Vitamíny a minerály Classic“.',
      en: "Hi! I'd like to order a birthday gift voucher: Vitamin & Mineral Classic IV Drip.",
    },
    productName: 'Vitamin & Mineral Classic IV Drip Birthday Gift Voucher, Prague',
    validFrom: '2026-01-01',
    priceValidUntil: '2026-12-31',
  },
} as const;
const variant = VARIANTS[kind];

const phone = '+420773629123';
const message = lang === 'ru' ? variant.whatsappMessage.ru : lang === 'cs' ? variant.whatsappMessage.cs : variant.whatsappMessage.en;
const whatsappLink = `https://wa.me/${phone.replace(/[^0-9]/g, '')}?text=${encodeURIComponent(message)}`;

// The old countdown ran to 8 March 2026 in the browser and showed the "expired" text after it.
// A static page decides at build time; every build after that date renders the expired text.
const WOMENS_DAY_TARGET_TIMESTAMP = new Date('2026-03-08T00:00:00+01:00').getTime();
const diff = WOMENS_DAY_TARGET_TIMESTAMP - Date.now();
const isPastDate = diff <= 0;
const timeLeft = {
  days: Math.floor(diff / (1000 * 60 * 60 * 24)),
  hours: Math.floor((diff / (1000 * 60 * 60)) % 24),
  minutes: Math.floor((diff / (1000 * 60)) % 60),
  seconds: Math.floor((diff / 1000) % 60),
};

const faqKeys = ['q1', 'q2', 'q3', 'q4', 'q5', 'q6', 'q7'] as const;
const faqItems = faqKeys.map((key) => ({
  question: t(`${k}.faq.items.${key}.question`),
  answer: t(`${k}.faq.items.${key}.answer`),
}));

const meta: PageMeta = {
  title: t(`${k}.seo.title`),
  description: t(`${k}.seo.description`),
  keywords: t(`${k}.seo.keywords`),
  ogImage: 'https://www.nius.cz/og-image.jpg',
  ogType: 'product',
  // One script holding the array, as the old SEO component wrote it.
  schema: [
    [
      {
        '@context': 'https://schema.org',
        '@type': 'Product',
        name: variant.productName,
        description: t(`${k}.seo.description`),
        image: 'https://www.nius.cz/og-image.jpg',
        brand: { '@type': 'Brand', name: 'NIUS (Nurse in Prague)' },
        offers: {
          '@type': 'Offer',
          price: '3750',
          priceCurrency: 'CZK',
          availability: 'https://schema.org/InStock',
          validFrom: variant.validFrom,
          priceValidUntil: variant.priceValidUntil,
          url: absoluteUrl(pageUrl(route.id, lang)),
        },
      },
      faqPageSchema(faqItems.map((item) => ({ question: item.question, answerHtml: item.answer }))),
      {
        '@context': 'https://schema.org',
        '@type': 'MedicalBusiness',
        name: 'NIUS (Nurse in Prague)',
        telephone: phone,
        url: 'https://www.nius.cz',
        address: {
          '@type': 'PostalAddress',
          addressLocality: 'Praha',
          addressCountry: 'CZ',
        },
        areaServed: { '@type': 'City', name: 'Prague' },
        openingHours: 'Mo-Su 08:00-21:00',
      },
    ],
  ],
};

const benefitKeys = ['unique', 'luxury', 'health', 'professional', 'convenient', 'voucher'] as const;
const benefitIcons = {
  unique: Sparkles,
  luxury: Heart,
  health: Droplets,
  professional: Shield,
  convenient: MapPin,
  voucher: Gift,
};

const experienceSteps = ['step1', 'step2', 'step3', 'step4'] as const;
const orderSteps = ['step1', 'step2', 'step3'] as const;
const testimonialKeys = ['t1', 't2', 't3'] as const;

const includedItems = t(`${k}.included.items`, { returnObjects: true }) as unknown as string[];
const corporateBenefits =
  kind === 'birthday' ? (t('birthdayGift.corporate.benefits', { returnObjects: true }) as unknown as string[]) : [];

const outlineCta = 'w-full sm:w-auto text-base px-8 py-6 border-indigo/20 text-indigo hover:bg-bone';
---

<BaseLayout route={route} lang={lang} meta={meta}>
  <div class="flex min-h-screen flex-col bg-background">
    <Header route={route} lang={lang} />
    <Breadcrumbs lang={lang} items={[{ label: t(`${k}.breadcrumb`) }]} />

    <main class="flex-1" role="main">
      {/* SECTION 1: HERO (+ COUNTDOWN) */}
      <section class="relative py-16 md:py-24 bg-bone overflow-hidden">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto text-center">
            <div class="flex flex-wrap justify-center gap-3 mb-8">
              {(['nurses', 'rating', 'available', 'districts'] as const).map((badge) => (
                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-white/80 backdrop-blur-sm border border-indigo/20 rounded-full text-xs font-medium text-indigo">
                  {badge === 'rating' && <Star class="h-3 w-3 fill-indigo text-indigo" />}
                  {badge === 'nurses' && <Shield class="h-3 w-3 text-indigo" />}
                  {badge === 'available' && <Clock class="h-3 w-3 text-indigo" />}
                  {badge === 'districts' && <MapPin class="h-3 w-3 text-indigo" />}
                  {t(`${k}.hero.trustBadges.${badge}`)}
                </span>
              ))}
            </div>

            {kind === 'birthday' ? (
              <span class="inline-flex items-center gap-2 px-4 py-1.5 mb-6 bg-bone text-indigo rounded-full text-sm font-semibold">
                <Cake class="h-4 w-4" />
                {t(`${k}.hero.badge`)}
              </span>
            ) : (
              <span class="inline-block px-4 py-1.5 mb-6 bg-bone text-indigo rounded-full text-sm font-semibold">{t(`${k}.hero.badge`)}</span>
            )}

            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-secondary mb-6 leading-tight md:leading-none lg:leading-none">
              {t(`${k}.hero.title`)}
            </h1>

            <p class="text-xl md:text-2xl text-indigo font-medium mb-4">
              {t(`${k}.hero.subtitle`)}
            </p>

            <p class="text-base md:text-lg text-muted-foreground max-w-3xl mx-auto mb-10 leading-relaxed md:leading-7">
              {t(`${k}.hero.description`)}
            </p>

            {kind === 'womensDay' && (
              <div class="mb-10">
                {isPastDate ? (
                  <p class="text-lg font-medium text-indigo">
                    {t('womensDayGift.countdown.expired')}
                  </p>
                ) : (
                  <div>
                    <p class="text-sm font-semibold text-indigo uppercase tracking-wider mb-3">
                      {t('womensDayGift.countdown.title')}
                    </p>
                    <div class="flex justify-center gap-3 md:gap-4">
                      {[
                        { value: timeLeft.days, label: t('womensDayGift.countdown.days') },
                        { value: timeLeft.hours, label: t('womensDayGift.countdown.hours') },
                        { value: timeLeft.minutes, label: t('womensDayGift.countdown.minutes') },
                        { value: timeLeft.seconds, label: t('womensDayGift.countdown.seconds') },
                      ].map((item) => (
                        <div class="flex flex-col items-center">
                          <div class="w-16 h-16 md:w-20 md:h-20 bg-white border-2 border-indigo/20 rounded-xl flex items-center justify-center shadow-xs">
                            <span class="text-2xl md:text-3xl font-bold text-indigo">
                              {String(item.value).padStart(2, '0')}
                            </span>
                          </div>
                          <span class="text-xs text-muted-foreground mt-1.5">{item.label}</span>
                        </div>
                      ))}
                    </div>
                  </div>
                )}
              </div>
            )}

            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href={whatsappLink} target="_blank" rel="noopener noreferrer">
                <Button size="lg" class="w-full sm:w-auto text-base px-8 py-6 bg-indigo hover:bg-indigo-deep">
                  <Gift class="mr-2 h-5 w-5" />
                  {t(`${k}.hero.cta`)}
                </Button>
              </a>
              <a href="#included">
                <Button size="lg" variant="outline" class={outlineCta}>
                  <ChevronDown class="mr-2 h-5 w-5" />
                  {t(`${k}.hero.ctaSecondary`)}
                </Button>
              </a>
            </div>
          </div>
        </div>
      </section>

      {/* SECTION 2: BENEFITS */}
      <section class="py-16 md:py-20">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mx-auto text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4">
              {t(`${k}.benefits.title`)}
            </h2>
            <p class="text-lg text-muted-foreground">
              {t(`${k}.benefits.subtitle`)}
            </p>
          </div>
          <div class="max-w-6xl mx-auto grid md:grid-cols-2 lg:grid-cols-3 gap-6">
            {benefitKeys.map((key) => {
              const Icon = benefitIcons[key];
              return (
                <Card class="p-6 border-indigo/20 hover:border-indigo/20 hover:shadow-lg hover:shadow-indigo/10 transition-all duration-300">
                  <div class="w-12 h-12 bg-bone rounded-xl flex items-center justify-center mb-4">
                    <Icon class="h-6 w-6 text-indigo" />
                  </div>
                  <h3 class="text-lg font-semibold text-secondary mb-2">
                    {t(`${k}.benefits.items.${key}.title`)}
                  </h3>
                  <p class="text-muted-foreground text-sm leading-relaxed">
                    {t(`${k}.benefits.items.${key}.description`)}
                  </p>
                </Card>
              );
            })}
          </div>
        </div>
      </section>

      {/* SECTION 3: WHAT'S INCLUDED */}
      <section id="included" class="py-16 md:py-20 bg-bone scroll-mt-20">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4">
                {t(`${k}.included.title`)}
              </h2>
              <p class="text-lg text-muted-foreground">
                {t(`${k}.included.subtitle`)}
              </p>
            </div>
            <div class="grid md:grid-cols-2 gap-4 mb-8">
              {includedItems.map((item) => (
                <div class="flex items-start gap-3 p-4 bg-white rounded-xl border border-indigo/20">
                  <CircleCheck class="h-5 w-5 text-indigo mt-0.5 flex-shrink-0" />
                  <span class="text-secondary font-medium">{item}</span>
                </div>
              ))}
            </div>
            <div class="text-center">
              <a href={pageUrl('iv-drips', lang)}>
                <Button variant="link" class="text-indigo hover:text-indigo">
                  {t(`${k}.included.learnMore`)}
                  <ArrowRight class="ml-1 h-4 w-4" />
                </Button>
              </a>
            </div>
          </div>
        </div>
      </section>

      {/* SECTION 4: THE GIFT EXPERIENCE */}
      <section class="py-16 md:py-20">
        <div class="container mx-auto px-4">
          <div class="max-w-4xl mx-auto">
            <div class="text-center mb-12">
              <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4">
                {t(`${k}.experience.title`)}
              </h2>
              <p class="text-lg text-muted-foreground">
                {t(`${k}.experience.subtitle`)}
              </p>
            </div>
            <div class="grid md:grid-cols-2 gap-6">
              {experienceSteps.map((step, i) => (
                <div class="relative flex gap-4 p-6 bg-bone rounded-xl border border-indigo/20">
                  <div class="w-10 h-10 bg-bone rounded-full flex items-center justify-center flex-shrink-0">
                    <span class="text-lg font-bold text-indigo">{i + 1}</span>
                  </div>
                  <div>
                    <h3 class="text-lg font-semibold text-secondary mb-1">
                      {t(`${k}.experience.steps.${step}.title`)}
                    </h3>
                    <p class="text-muted-foreground text-sm">
                      {t(`${k}.experience.steps.${step}.description`)}
                    </p>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* SECTION 5: VOUCHER DETAILS */}
      <section class="py-16 md:py-20 bg-bone">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mx-auto text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-8">
              {t(`${k}.voucher.title`)}
            </h2>
            <div class="flex flex-wrap justify-center gap-4">
              {(['validity', 'redeemable', 'transferable', 'personalized', 'instant'] as const).map((key) => (
                <div class="flex items-center gap-2 px-4 py-3 bg-white rounded-xl border border-indigo/20 shadow-xs">
                  <CircleCheck class="h-4 w-4 text-indigo flex-shrink-0" />
                  <span class="text-sm font-medium text-secondary">
                    {t(`${k}.voucher.${key}`)}
                  </span>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      {/* SECTION 6: PRICING & CTA */}
      <section id="pricing" class="py-16 md:py-20 scroll-mt-20">
        <div class="container mx-auto px-4">
          <div class="max-w-2xl mx-auto">
            <Card class="p-8 md:p-12 border-2 border-indigo/20 bg-bone text-center">
              <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-2">
                {t(`${k}.pricing.title`)}
              </h2>
              <p class="text-muted-foreground mb-8">
                {t(`${k}.pricing.subtitle`)}
              </p>

              <div class="mb-2"><span class="text-5xl md:text-6xl font-bold text-indigo">{t(`${k}.pricing.price`)}</span><span class="text-2xl font-medium text-indigo ml-2">{t(`${k}.pricing.currency`)}</span></div>
              <p class="text-muted-foreground text-sm mb-1">
                {t(`${k}.pricing.approximateEur`)} · {t(`${k}.pricing.perSession`)}
              </p>
              <p class="text-sm font-medium text-green-600 mb-8">
                {t(`${k}.pricing.includes`)}
              </p>

              <div class="flex flex-col gap-3">
                <a href={whatsappLink} target="_blank" rel="noopener noreferrer">
                  <Button size="lg" class="w-full text-base py-6 bg-green-600 hover:bg-green-700">
                    <MessageCircle class="mr-2 h-5 w-5" />
                    {t(`${k}.pricing.ctaWhatsApp`)}
                  </Button>
                </a>
                <a href={`tel:${phone}`}>
                  <Button size="lg" variant="outline" class="w-full text-base py-6 border-indigo/20 text-indigo hover:bg-bone">
                    <Phone class="mr-2 h-5 w-5" />
                    {t(`${k}.pricing.ctaCall`)}
                  </Button>
                </a>
              </div>
            </Card>
          </div>
        </div>
      </section>

      {/* SECTION 7: TESTIMONIALS */}
      <section class="py-16 md:py-20 bg-muted/30">
        <div class="container mx-auto px-4">
          <h2 class="text-3xl md:text-4xl font-bold text-secondary text-center mb-12">
            {t(`${k}.testimonials.title`)}
          </h2>
          <div class="max-w-5xl mx-auto grid md:grid-cols-3 gap-6">
            {testimonialKeys.map((key) => (
              <Card class="p-6 border-indigo/20">
                <div class="flex gap-1 mb-4">
                  {[1, 2, 3, 4, 5].map(() => (
                    <Star class="h-4 w-4 fill-indigo text-indigo" />
                  ))}
                </div>
                <p class="text-muted-foreground text-sm leading-relaxed mb-4 italic">"{t(`${k}.testimonials.items.${key}.text`)}"</p>
                <div class="text-sm"><span class="font-semibold text-secondary">{t(`${k}.testimonials.items.${key}.author`)}</span><span class="text-muted-foreground ml-1">{t(`${k}.testimonials.items.${key}.location`)}</span></div>
              </Card>
            ))}
          </div>
        </div>
      </section>

      {/* SECTION 8 (birthday only): CORPORATE / B2B */}
      {kind === 'birthday' && (
        <section class="py-16 md:py-20">
          <div class="container mx-auto px-4">
            <div class="max-w-4xl mx-auto">
              <div class="bg-bone rounded-xl p-8 md:p-12 border border-slate-200">
                <div class="flex items-center gap-3 mb-6">
                  <div class="w-12 h-12 bg-slate-100 rounded-xl flex items-center justify-center">
                    <Building2 class="h-6 w-6 text-slate-600" />
                  </div>
                  <div>
                    <h2 class="text-2xl md:text-3xl font-bold text-secondary">
                      {t('birthdayGift.corporate.title')}
                    </h2>
                  </div>
                </div>
                <p class="text-lg text-muted-foreground mb-8">
                  {t('birthdayGift.corporate.subtitle')}
                </p>
                <div class="grid sm:grid-cols-2 gap-3 mb-8">
                  {corporateBenefits.map((benefit) => (
                    <div class="flex items-start gap-3 p-3">
                      <CircleCheck class="h-5 w-5 text-indigo mt-0.5 flex-shrink-0" />
                      <span class="text-secondary text-sm font-medium">{benefit}</span>
                    </div>
                  ))}
                </div>
                <a href={whatsappLink} target="_blank" rel="noopener noreferrer">
                  <Button size="lg" class="bg-slate-700 hover:bg-slate-800">
                    <MessageCircle class="mr-2 h-5 w-5" />
                    {t('birthdayGift.corporate.cta')}
                  </Button>
                </a>
              </div>
            </div>
          </div>
        </section>
      )}

      {/* HOW TO ORDER */}
      <section class={kind === 'birthday' ? 'py-16 md:py-20 bg-bone' : 'py-16 md:py-20'}>
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mx-auto text-center mb-12">
            <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4">
              {t(`${k}.howToOrder.title`)}
            </h2>
            <p class="text-lg text-muted-foreground">
              {t(`${k}.howToOrder.subtitle`)}
            </p>
          </div>
          <div class="max-w-4xl mx-auto grid md:grid-cols-3 gap-8">
            {orderSteps.map((step, i) => (
              <div class="text-center">
                <div class="w-14 h-14 bg-bone rounded-full flex items-center justify-center mx-auto mb-4">
                  <span class="text-xl font-bold text-indigo">{i + 1}</span>
                </div>
                <h3 class="text-lg font-semibold text-secondary mb-2">
                  {t(`${k}.howToOrder.steps.${step}.title`)}
                </h3>
                <p class="text-muted-foreground text-sm">
                  {t(`${k}.howToOrder.steps.${step}.description`)}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>

      {/* FAQ */}
      <section class={kind === 'birthday' ? 'py-16 md:py-20' : 'py-16 md:py-20 bg-bone'}>
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mx-auto">
            <h2 class="text-3xl md:text-4xl font-bold text-secondary text-center mb-12">
              {t(`${k}.faq.title`)}
            </h2>
            <GiftFaq items={faqItems} />
          </div>
        </div>
      </section>

      {/* FINAL CTA */}
      <section class="py-16 md:py-20 bg-bone">
        <div class="container mx-auto px-4">
          <div class="max-w-3xl mx-auto text-center">
            <h2 class="text-3xl md:text-4xl font-bold text-secondary mb-4">
              {t(`${k}.finalCta.title`)}
            </h2>
            <p class="text-lg text-muted-foreground mb-10">
              {t(`${k}.finalCta.description`)}
            </p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center">
              <a href={whatsappLink} target="_blank" rel="noopener noreferrer">
                <Button size="lg" class="w-full sm:w-auto text-base px-8 py-6 bg-green-600 hover:bg-green-700">
                  <MessageCircle class="mr-2 h-5 w-5" />
                  {t(`${k}.finalCta.whatsapp`)}
                </Button>
              </a>
              <a href={`tel:${phone}`}>
                <Button size="lg" variant="outline" class={outlineCta}>
                  <Phone class="mr-2 h-5 w-5" />
                  {phone}
                </Button>
              </a>
              <a href="mailto:info@nius.cz">
                <Button size="lg" variant="outline" class={outlineCta}>
                  <Mail class="mr-2 h-5 w-5" />
                  {t(`${k}.finalCta.email`)}
                </Button>
              </a>
            </div>
          </div>
        </div>
      </section>
    </main>

    <Footer route={route} lang={lang} />
  </div>
</BaseLayout>
