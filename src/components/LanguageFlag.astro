---
// Small inline SVG flags (no emoji, so they render the same on every OS), as the old LanguageFlag.
interface Props {
  lang: string;
  class?: string;
  /** Circular crop (square box); otherwise a small rectangular flag. */
  round?: boolean;
}

const { lang, class: className, round = false } = Astro.props;
const boxClass = className ?? (round ? 'h-10 w-10' : 'h-3.5 w-[21px]');
const preserveAspectRatio = round ? (lang === 'cs' ? 'xMinYMid slice' : 'xMidYMid slice') : undefined;
---

<svg
  viewBox="0 0 24 16"
  class={`${boxClass} ${round ? 'rounded-full' : 'rounded-[2px]'} shrink-0`}
  preserveAspectRatio={preserveAspectRatio}
  style="box-shadow: 0 0 0 0.5px rgba(42,44,46,0.25);"
  aria-hidden="true"
  focusable="false"
>
  {lang === 'cs' ? (
    <>
      <rect width="24" height="8" fill="#ffffff" />
      <rect y="8" width="24" height="8" fill="#d7141a" />
      <path d="M0 0L12 8L0 16Z" fill="#11457e" />
    </>
  ) : lang === 'en' ? (
    <>
      <rect width="24" height="16" fill="#012169" />
      <path d="M0 0L24 16M24 0L0 16" stroke="#ffffff" stroke-width="3" />
      <path d="M0 0L24 16M24 0L0 16" stroke="#c8102e" stroke-width="1.2" />
      <path d="M12 0V16M0 8H24" stroke="#ffffff" stroke-width="5" />
      <path d="M12 0V16M0 8H24" stroke="#c8102e" stroke-width="3" />
    </>
  ) : lang === 'ru' ? (
    <>
      <rect width="24" height="5.34" fill="#ffffff" />
      <rect y="5.33" width="24" height="5.34" fill="#0039a6" />
      <rect y="10.66" width="24" height="5.34" fill="#d52b1e" />
    </>
  ) : lang === 'uk' ? (
    <>
      <rect width="24" height="8" fill="#0057b7" />
      <rect y="8" width="24" height="8" fill="#ffd700" />
    </>
  ) : (
    <rect width="24" height="16" fill="#d9d9d9" />
  )}
</svg>
