---
// The bottom bar of the home page and the drips page (the page needs a hero with id="home").
// Port of old:src/components/MobileStickyBar.tsx: the static state of the old bar before its first
// effect (hero in view, empty cart). src/scripts/sticky-bar.ts runs it; the cart total under the
// label is rendered by StickyTotal from the order form code into [data-sticky-total].
import { createT } from '@/i18n/t.ts';
import type { Lang } from '@/routes/types.ts';

interface Props {
  lang: Lang;
}

const t = createT(Astro.props.lang);
// The WhatsApp mark of the old bar (18 px, unlike icons/WhatsApp.astro, which sizes by class).
const WA_PATH_1 =
  'M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z';
const WA_PATH_2 =
  'M12 0C5.373 0 0 5.373 0 12c0 2.625.846 5.059 2.284 7.034L.789 23.492l4.574-1.472A11.94 11.94 0 0012 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818c-2.17 0-4.183-.59-5.926-1.613l-.424-.253-2.715.874.866-2.634-.278-.44A9.77 9.77 0 012.182 12c0-5.418 4.4-9.818 9.818-9.818S21.818 6.582 21.818 12s-4.4 9.818-9.818 9.818z';
---

<div
  data-mobile-sticky
  class="fixed bottom-0 left-0 right-0 z-50 flex gap-3 px-4 py-3 transition-transform duration-300 translate-y-full"
  style="background-color: white; border-top: 1px solid var(--color-line); box-shadow: 0 -2px 12px rgba(0,0,0,0.06); display: var(--sticky-bar-display, none); padding-bottom: max(12px, env(safe-area-inset-bottom, 0px));"
>
  <button
    type="button"
    tabindex="-1"
    data-sticky-main
    data-label-choose={t('heroNew.ctaPrimary')}
    data-label-cart={t('nav.cart')}
    class="min-w-0 flex-1 flex flex-col items-center justify-center gap-0.5 px-2 py-3 rounded-full font-body font-medium text-sm text-white"
    style="background-color: var(--color-indigo);"
  >
    <span data-sticky-label>{t('heroNew.ctaPrimary')}</span>
    <span data-sticky-total class="contents"></span>
  </button>
  <a
    href="https://wa.me/420773629123"
    target="_blank"
    rel="noopener noreferrer"
    data-analytics-source="mobile_sticky"
    tabindex="-1"
    class="ml-auto flex shrink-0 items-center justify-center gap-2 px-4 py-3 rounded-full font-body font-medium text-sm"
    style="color: var(--color-indigo); border: 1.5px solid var(--color-indigo); background-color: transparent;"
  >
    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d={WA_PATH_1} /><path d={WA_PATH_2} /></svg>
    WhatsApp
  </a>
</div>
