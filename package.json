{
  "name": "nius-site",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/finalize-dist.mjs",
    "preview": "astro preview",
    "lint": "eslint .",
    "typecheck": "astro check",
    "test": "vitest run",
    "i18n:check": "node scripts/check-i18n-keys.mjs",
    "check:env": "node scripts/check-env.mjs",
    "preview:assemble": "node scripts/preview/assemble.mjs",
    "check:seo": "node scripts/checks/seo-check.ts",
    "checks:report": "node scripts/checks/registry.ts",
    "check:e2e": "playwright test --project=e2e",
    "check:lhci": "node scripts/checks/lighthouse-check.ts",
    "checks": "npm run lint && npm run typecheck && npm test && npm run i18n:check && npm run build && npm run check:seo -- --scope built && npm run check:e2e && npm run check:lhci"
  },
  "dependencies": {
    "@amplitude/analytics-browser": "^2.49.2",
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "7.1.3",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@lucide/astro": "^1.71.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-slot": "^1.5.0",
    "@react-oauth/google": "^0.13.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "astro": "^7.4.9",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "i18next": "^27.1.1",
    "lucide-react": "^1.71.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-phone-number-input": "^3.4.18",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "web-vitals": "^6.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.16.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-plugin-astro": "^1.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^31.0.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.0"
  }
}
